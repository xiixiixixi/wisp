{
  "name": "workflow-automation-extension",
  "version": "1.0.0",
  "description": "Workflow automation extension for Wisp - detects package manager conflicts and more",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "package": "wisp-sdk package"
  },
  "devDependencies": {
    "@wisp/extension-sdk": "file:../..",
    "typescript": "^5.0.0"
  },
  "wisp": {
    "id": "workflow-automation",
    "displayName": "Workflow Automation",
    "category": "tool",
    "version": "1.0.0",
    "author": "Wisp Team",
    "description": "Automated workflow checks and warnings for common development issues",
    "keywords": [
      "workflow",
      "automation",
      "lint",
      "package-manager",
      "conflict-detection"
    ],
    "icon": "⚡",
    "permissions": [
      "directory:list",
      "file:read",
      "ui:notifications"
    ],
    "contributes": {
      "panels": [
        {
          "id": "workflow-warnings",
          "title": "Workflow Warnings",
          "location": "bottom",
          "icon": "⚠️",
          "when": "workspaceHasIssues"
        }
      ],
      "commands": [
        {
          "command": "scanWorkspace",
          "title": "Scan for Workflow Issues",
          "category": "Workflow",
          "icon": "🔍"
        }
      ]
    },
    "activationEvents": [
      "onDirectoryOpen",
      "onFileChange"
    ]
  }
}
