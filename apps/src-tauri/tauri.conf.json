{
  "productName": "Wisp",
  "version": "0.99.6",
  "identifier": "com.wisp.app",
  "build": {
    "beforeBuildCommand": "pnpm -w frontend:build",
    "frontendDist": "../client/dist",
    "devUrl": "http://localhost:5174"
  },
  "app": {
    "windows": [
      {
        "title": "Wisp - File Explorer",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "hiddenTitle": true,
        "titleBarStyle": "Overlay",
        "trafficLightPosition": {
          "x": 12,
          "y": 20
        },
        "alwaysOnTop": false,
        "center": true,
        "acceptFirstMouse": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' asset: https://asset.localhost http://asset.localhost data:; connect-src 'self' ipc: http://ipc.localhost https://asset.localhost http://asset.localhost https://xplorer.space https://*.xplorer.space http://localhost:*; media-src 'self' asset: https://asset.localhost http://asset.localhost; object-src 'none'; base-uri 'self'",
      "capabilities": [
        "default"
      ],
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/**",
          "$APPDATA/**",
          "$LOCALAPPDATA/**",
          "$DOCUMENT/**",
          "$DOWNLOAD/**",
          "$DESKTOP/**",
          "$PICTURE/**",
          "$VIDEO/**",
          "$AUDIO/**",
          "../client/dist/**"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/xiixiixixi/wisp/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ2MjlDNjgwRUJENjAxOTEKUldTUkFkYnJnTVlwUnFxcUVtTkIzdUxoUkxwZkVzOWExSzQyZzhKZ3hoOUFKSHBqZVdHUGtNbWUK"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "resources": {
      "../../packages/cli/bin/wisp.mjs": "wisp.mjs"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "publisher": "Wisp",
    "copyright": "Copyright 2025 Wisp",
    "category": "Utility",
    "shortDescription": "Modern file explorer",
    "longDescription": "A modern file explorer built with Tauri, React, and TypeScript",
    "fileAssociations": [
      {
        "ext": [
          "xtension"
        ],
        "mimeType": "application/x-wisp-extension",
        "description": "Wisp Extension Package"
      }
    ],
    "windows": {
      "nsis": {
        "installerHooks": "./windows/hooks.nsh"
      }
    },
    "macOS": {
      "signingIdentity": "Apple Development: xiixiixixi@gmail.com (XZTBXM8859)"
    }
  }
}
